# Reference only: no automatic .env loader. Set PowerShell environment variables.
NEXTRELAY_ENV=development
NEXTRELAY_AUTH_MODE=dev-token
NEXTRELAY_DEV_SUBJECT=dev-synthetic-user
NEXTRELAY_HOST=127.0.0.1
NEXTRELAY_PORT=8000
# Generate per session: py -3.14 -c "import secrets; print(secrets.token_urlsafe(32))"
# NEXTRELAY_DEV_TOKEN=<generated locally; never commit>
# Default: %LOCALAPPDATA%\NextRelay\dev.sqlite3 (outside project/OneDrive)
# NEXTRELAY_DB_PATH=C:\absolute\local\path\dev.sqlite3
# T11 uploads require an existing explicitly selected local directory, outside sync/project.
# NEXTRELAY_LOCAL_ROOT=C:\absolute\local\path\originals

# T09: disabled by default. This does not grant permission to send any batch.
NEXTRELAY_MODEL_PROVIDER=disabled
# Supported optional production wire adapter: openai-responses
# Explicit model required; choose a structured-output capable exact model ID.
# NEXTRELAY_MODEL_NAME=<explicit model ID>
# NEXTRELAY_MODEL_ENDPOINT=https://api.openai.com/v1/responses
# NEXTRELAY_MODEL_API_KEY=<set in server environment; never commit or print>
# Arbitrary endpoints, proxy forwarding, redirects and env-enabled loopback are rejected.
# Per item: at most one request, no automatic retries, 20s configured deadline,
# 512KiB request / 256KiB response. Exact batch preview + approval still required.

# T10: public GitHub uses the existing NEXTRELAY_LOCAL_ROOT for explicit local storage.
# No GitHub token/account, arbitrary endpoint, proxy or safety-disable setting.
# Use the materials page to preview pinned scope, read, confirm expansion, retry/update.
# Non-public DNS answers (including intercepted/fake addresses) fail closed.
